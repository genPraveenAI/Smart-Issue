EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
ALLOW_MODEL_DOWNLOADS=true
MODEL_CACHE_PATH=.data/models
CHROMA_PATH=.data/chroma
MAX_CONTEXT_TOKENS=420

# Optional hosted drafting through OpenRouter. The app requires explicit in-app consent.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional local report drafting with Ollama. Used as a local fallback when configured.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Jira stays disabled unless explicitly enabled and all values are provided.
JIRA_ENABLED=false
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=